{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Page host — GET /p/<slug> and /p/<slug>/data",
    "output": "sequence-page-host.html",
    "viewBox": [1040, 500],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "user", "type": "external", "label": "Operator", "sublabel": "browser" },
    { "id": "rt", "type": "frontend", "label": "Page runtime", "sublabel": "page.js" },
    { "id": "ssr", "type": "backend", "label": "Page host route", "sublabel": "/p/*" },
    { "id": "svc", "type": "backend", "label": "Report Service", "sublabel": "run + getViews" },
    { "id": "pool", "type": "backend", "label": "Worker pool", "sublabel": "threads" }
  ],
  "segments": [
    { "from": 160, "to": 250, "label": "Shell + manifest" },
    { "from": 265, "to": 375, "label": "Named report result" },
    { "from": 390, "to": 417, "label": "Browser renders" }
  ],
  "messages": [
    { "id": "open", "from": "user", "to": "rt", "y": 172, "label": "open /p/reports/payments", "variant": "emphasis" },
    { "id": "shell", "from": "rt", "to": "ssr", "y": 206, "label": "GET /p/reports/payments", "variant": "default" },
    { "id": "manifest", "from": "ssr", "to": "rt", "y": 240, "label": "HTML shell + manifest JSON", "variant": "return" },
    { "id": "data", "from": "rt", "to": "ssr", "y": 274, "label": "GET /data?filters", "variant": "emphasis" },
    { "id": "run", "from": "ssr", "to": "svc", "y": 308, "label": "run(compute.report, filters)", "variant": "emphasis" },
    { "id": "dispatch", "from": "svc", "to": "pool", "y": 342, "label": "aggregate on threads", "variant": "dashed" },
    { "id": "json", "from": "ssr", "to": "rt", "y": 376, "label": "200 gzip JSON + ETag", "variant": "return" },
    { "id": "render", "from": "rt", "to": "user", "y": 410, "label": "rows + totals on screen (no compute)", "variant": "return" }
  ],
  "activations": [
    { "participant": "rt", "from": 168, "to": 425, "type": "frontend" },
    { "participant": "ssr", "from": 205, "to": 390, "type": "backend" },
    { "participant": "svc", "from": 303, "to": 350, "type": "backend" },
    { "participant": "pool", "from": 338, "to": 360, "type": "backend" }
  ],
  "cards": [
    { "dot": "violet", "title": "The manifest is the page", "items": ["meta.json names a trusted compute.report", "Node holds no page-specific code"] },
    { "dot": "cyan", "title": "Result, not views", "items": ["/data returns {version, filters, result, meta} plus select sources", "ETag revalidation returns 304; median 44 ms and 124 KB"] }
  ]
}
