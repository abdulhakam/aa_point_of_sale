# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/node_modules
/guests/node_modules
/trailbase/static

/legacyforparity/

# performance-plan scratch artifacts (local evidence, not source)
/pb_bench_serve.out.txt
/pb_bench_serve.err.txt
/scripts/*.err.txt
/scripts/baseline_sql.txt
/scripts/baseline_sql_full.txt
/scripts/baseline_http.txt
/scripts/after_indexes_http.txt
/scripts/after_indexes_sql.txt
/scripts/equiv.txt
/scripts/ledger_party_sql.txt
/scripts/frontend_build.txt
/scripts/frontend_build2.txt
/scripts/pg_before.txt
/scripts/pg_after.txt
/scripts/views_dump.txt
# SQLite WAL sidecars. backend/p_data/data.db is tracked AND runs in WAL mode, so these
# must never be staged: a live -wal beside a tracked -db makes the committed file
# disagree with the running database. Seen produced by read-only connections too.
*.db-wal
*.db-shm

# Python bytecode from the bench harnesses in trailbase/tools
__pycache__/

# Dated run output from the report sweep/parity harnesses, and the parity scratch dir. These are
# local evidence, not source; a blanket `git add -A` must not publish them.
trailbase/tools/sweep-*.json
vault/attachments/_parity-test/
vault/attachments/report-parity-*/

# ---------------------------------------------------------------------------
# Heavy artefacts that must never enter history again.
#
# On 2026-10-12 the history was rewritten to drop ~370 MB of tracked databases and
# compiled binaries (legacy backend\ and standalone\) plus ~900 MB of stale dangling
# objects. These rules keep the same classes of file out from now on. Nothing that is
# tracked today matches any of them.
# ---------------------------------------------------------------------------

# PocketBase / TrailBase data directories and any SQLite database, wherever it sits.
pb_data/
p_data/
*.db
*.sqlite
*.sqlite3

# Compiled binaries and native build output.
*.exe
*.dll
*.node
*.lib
*.pdb
*.rlib
*.so
*.dylib
*.o
*.obj
*.a

# Local route-fingerprint baseline written by the snapshot tool.
/.kilo/route-snapshot-baseline.txt
