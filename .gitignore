/scripts/views_dump.txt
# SQLite WAL sidecars. backend/p_data/data.db is tracked AND runs in WAL mode, so these
# must never be staged: a live -wal beside a tracked -db makes the committed file
# disagree with the running database. Seen produced by read-only connections too.
*.db-wal
*.db-shm
