# Copy to .env and adjust.

# TrailBase server base URL (CRUD + auth only).
# NOTE: `trailbase/RUN.BAT` binds TrailBase to 127.0.0.1 explicitly because TrailBase's
# own default is [::1]:4000 (IPv6 only) - a client at 127.0.0.1 cannot reach that. If you
# start the server yourself, pass --address=127.0.0.1:4000 or point this at [::1] instead.
TRAILBASE_URL=http://127.0.0.1:4000

# This frontend's own listen address.
HOST=127.0.0.1
PORT=3100

# Secret used to sign the session cookie. Change it.
SESSION_SECRET=change-me-to-a-long-random-string

# Application name shown in the header.
APP_NAME=AA Point of Sale

# Report worker threads (0 = number of CPUs - 1, min 1).
WORKER_THREADS=0

# Reference/base-table cache TTL in seconds.
CACHE_TTL_SECONDS=60
