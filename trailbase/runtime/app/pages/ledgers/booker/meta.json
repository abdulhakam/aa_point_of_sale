{
  "title": "Booker Sales Ledger",
  "template": "page.html",
  "hub": {
    "title": "Booker",
    "target": "ledgers/booker",
    "tone": "green",
    "icon": "user-dollar",
    "hub": "ledgers",
    "order": 1
  },
  "compute": {
    "report": "ledgers/booker"
  },
  "spool": {
    "sql": "ledger_booker.sql",
    "row": [
      "id",
      "date",
      "entry",
      "credit",
      "creditText",
      "debit",
      "debitText",
      "party",
      "booker",
      "invoice",
      "invoiceId"
    ],
    "totals": {
      "cents": {
        "credit": "credit",
        "debit": "debit"
      },
      "derived": {
        "balance": {
          "op": "-",
          "terms": [
            "credit",
            "debit"
          ]
        }
      }
    }
  },
  "filters": [
    "dateRangePayments",
    "booker"
  ],
  "columns": [
    {
      "key": "date",
      "label": "Date"
    },
    {
      "key": "invoice",
      "label": "Invoice"
    },
    {
      "key": "entry",
      "label": "Entry"
    },
    {
      "key": "creditText",
      "label": "Credit",
      "right": true
    },
    {
      "key": "debitText",
      "label": "Debit",
      "right": true
    }
  ],
  "requires": [
    "booker"
  ],
  "totals": [
    {
      "label": "Total Credit",
      "key": "credit"
    },
    {
      "label": "Total Debit",
      "key": "debit"
    },
    {
      "label": "Final Balance",
      "key": "balance"
    }
  ]
}
