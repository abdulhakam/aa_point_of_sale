{
  "title": "Party Ledger",
  "template": "page.html",
  "hub": {
    "title": "Party",
    "target": "ledgers/party",
    "tone": "orange",
    "icon": "clipboard-data",
    "hub": "ledgers",
    "order": 3
  },
  "needs": {
    "views": [
      "ledgerParty",
      "invoiceView",
      "refs"
    ]
  },
  "compute": {
    "report": "ledgers/party"
  },
  "filters": [
    {
      "name": "from",
      "label": "Date From",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "to",
      "label": "Date To",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "party",
      "label": "Party",
      "type": "select",
      "source": "parties"
    }
  ],
  "columns": [
    {
      "key": "date",
      "label": "Date"
    },
    {
      "key": "invoice",
      "label": "Inv #"
    },
    {
      "key": "entry",
      "label": "Entry"
    },
    {
      "key": "creditText",
      "label": "Credit",
      "right": true
    },
    {
      "key": "debitText",
      "label": "Debit",
      "right": true
    },
    {
      "key": "balanceText",
      "label": "Balance",
      "right": true
    }
  ],
  "requires": [
    "party"
  ],
  "totals": [
    {
      "label": "Final Balance",
      "key": "balance"
    }
  ]
}
