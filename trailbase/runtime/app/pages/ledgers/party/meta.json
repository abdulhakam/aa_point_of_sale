{
  "title": "Party Ledger",
  "template": "page.html",
  "hub": {
    "title": "Party",
    "target": "ledgers/party",
    "tone": "orange",
    "icon": "clipboard-data",
    "hub": "ledgers",
    "order": 3
  },
  "compute": {
    "report": "ledgers/party"
  },
  "spool": {
    "sql": "ledger_party.sql",
    "row": [
      "id",
      "date",
      "entry",
      "credit",
      "creditText",
      "debit",
      "debitText",
      "balance",
      "balanceText",
      "party",
      "booker",
      "invoice",
      "invoiceId",
      "paymentDate"
    ],
    "totals": {
      "order": "date DESC, paymentDate DESC, id ASC",
      "pick": {
        "balance": "balance"
      }
    }
  },
  "filters": [
    "dateRangePayments",
    "party"
  ],
  "columns": [
    {
      "key": "date",
      "label": "Date"
    },
    {
      "key": "invoice",
      "label": "Invoice"
    },
    {
      "key": "entry",
      "label": "Entry"
    },
    {
      "key": "creditText",
      "label": "Credit",
      "right": true
    },
    {
      "key": "debitText",
      "label": "Debit",
      "right": true
    },
    {
      "key": "balanceText",
      "label": "Balance",
      "right": true
    }
  ],
  "requires": [
    "party"
  ],
  "totals": [
    {
      "label": "Final Balance",
      "key": "balance"
    }
  ]
}
