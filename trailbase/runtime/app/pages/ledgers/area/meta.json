{
  "title": "Area Ledger",
  "template": "page.html",
  "hub": {
    "title": "Area",
    "target": "ledgers/area",
    "tone": "green",
    "icon": "map",
    "hub": "ledgers",
    "order": 0
  },
  "compute": {
    "report": "ledgers/area"
  },
  "spool": {
    "sql": "ledger_area.sql",
    "row": [
      "id",
      "party",
      "credit",
      "debit",
      "balance",
      "creditText",
      "debitText",
      "balanceText",
      "credit_raw",
      "debit_raw"
    ],
    "totals": {
      "cents": {
        "credit": "credit",
        "debit": "debit",
        "balance": "balance"
      }
    }
  },
  "filters": [
    {
      "name": "from",
      "label": "Date From",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "to",
      "label": "Date To",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "area",
      "label": "Area",
      "type": "select",
      "source": "areas"
    },
    {
      "name": "section",
      "label": "Section",
      "type": "select",
      "source": "sections"
    }
  ],
  "columns": [
    {
      "key": "party",
      "label": "Party"
    },
    {
      "key": "debitText",
      "label": "Debit",
      "right": true
    },
    {
      "key": "creditText",
      "label": "Credit",
      "right": true
    },
    {
      "key": "balanceText",
      "label": "Balance",
      "right": true
    }
  ],
  "totals": [
    {
      "label": "Total Debit",
      "key": "debit"
    },
    {
      "label": "Total Credit",
      "key": "credit"
    },
    {
      "label": "Total Balance",
      "key": "balance"
    }
  ]
}
