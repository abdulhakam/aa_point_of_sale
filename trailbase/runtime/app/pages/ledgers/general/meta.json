{
  "title": "General Ledger",
  "template": "page.html",
  "view": "reports/ledgers/general.html",
  "handlers": [
    "handlers/openings.js"
  ],
  "hub": {
    "title": "General",
    "target": "ledgers/general",
    "tone": "yellow",
    "icon": "report-money",
    "hub": "ledgers",
    "order": 2
  },
  "compute": {
    "report": "ledgers/general"
  },
  "spool": {
    "sql": "ledger_general.sql",
    "row": [
      "id",
      "date",
      "invoiceNo",
      "description",
      "transactionType",
      "accountType",
      "recievable",
      "recievableText",
      "payable",
      "payableText",
      "cash",
      "cashText",
      "stock",
      "stockText",
      "tone"
    ],
    "totals": {
      "openings": {
        "openR": ":openingRecievables",
        "openP": ":openingPayables",
        "openC": ":openingCash"
      },
      "cents": {
        "recievable": "recievable",
        "payable": "payable",
        "cash": "cash"
      },
      "derived": {
        "recievable": {
          "op": "+",
          "terms": [
            "recievable",
            "openR"
          ]
        },
        "payable": {
          "op": "+",
          "terms": [
            "payable",
            "openP"
          ]
        },
        "cash": {
          "op": "+",
          "terms": [
            "cash",
            "openC"
          ]
        }
      },
      "consts": {
        "stock": "0"
      }
    }
  },
  "filters": [
    {
      "name": "from",
      "label": "Date From",
      "type": "date",
      "default": {
        "fn": "monthStart"
      }
    },
    {
      "name": "to",
      "label": "Date To",
      "type": "date",
      "default": {
        "fn": "today"
      }
    }
  ],
  "columns": [
    {
      "key": "date",
      "label": "Date"
    },
    {
      "key": "invoiceNo",
      "label": "Inv #"
    },
    {
      "key": "description",
      "label": "Description"
    },
    {
      "key": "transactionType",
      "label": "Type"
    },
    {
      "key": "accountType",
      "label": "Account"
    },
    {
      "key": "recievableText",
      "label": "Recievables",
      "right": true
    },
    {
      "key": "payableText",
      "label": "Payables",
      "right": true
    },
    {
      "key": "cashText",
      "label": "Cash",
      "right": true
    }
  ],
  "totals": [
    {
      "label": "Recievables",
      "key": "recievable"
    },
    {
      "label": "Payables",
      "key": "payable"
    },
    {
      "label": "Cash",
      "key": "cash"
    }
  ],
  "openings": true
}
