{
  "title": "Outstanding Payments Report",
  "template": "page.html",
  "hub": {
    "title": "Outstanding Payments",
    "target": "outstanding",
    "tone": "cyan",
    "icon": "report-money",
    "hub": "reports",
    "order": 8
  },
  "needs": {
    "views": [
      "outstanding"
    ]
  },
  "compute": {
    "report": "outstanding"
  },
  "filters": [
    {
      "name": "booker",
      "label": "Booker",
      "type": "select",
      "source": "order_bookers"
    },
    {
      "name": "area",
      "label": "Area",
      "type": "select",
      "source": "areas"
    },
    {
      "name": "section",
      "label": "Section",
      "type": "select",
      "source": "sections"
    }
  ],
  "columns": [
    {
      "key": "party_name",
      "label": "Party Name"
    },
    {
      "key": "invoice_nos",
      "label": "Invoices",
      "wrap": true
    },
    {
      "key": "invoice_totalText",
      "label": "Total Amount",
      "right": true
    },
    {
      "key": "paid_totalText",
      "label": "Total Paid",
      "right": true
    },
    {
      "key": "balanceText",
      "label": "Balance",
      "right": true
    }
  ],
  "totals": [
    {
      "label": "Total",
      "join": [
        "invoice",
        " / ",
        "paid",
        " / ",
        "balance"
      ]
    }
  ]
}
