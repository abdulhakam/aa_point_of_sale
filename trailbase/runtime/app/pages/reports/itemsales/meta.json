{
  "title": "Item Sales Report",
  "template": "page.html",
  "hub": {
    "title": "Item Sales Report",
    "target": "itemsales",
    "tone": "pink",
    "icon": "chart-bar",
    "hub": "reports",
    "order": 1
  },
  "compute": {
    "report": "itemsales"
  },
  "spool": {
    "sql": "transactions.sql",
    "row": [
      "id",
      "date",
      "type",
      "typeLetter",
      "booker",
      "invoiceNo",
      "invoiceId",
      "party",
      "company",
      "area",
      "section",
      "item",
      "itemId",
      "price",
      "qty",
      "qtyText",
      "scheme",
      "net_amount",
      "net_amountText",
      "final_amount",
      "final_amountText",
      "profit",
      "profitText",
      "type_code"
    ],
    "totals": {
      "cents": {
        "sale": "CASE WHEN type_code = 1 THEN final_amount ELSE 0 END",
        "returns": "CASE WHEN type_code = 1 THEN 0 ELSE final_amount END"
      },
      "derived": {
        "total": {
          "op": "-",
          "terms": [
            "sale",
            "returns"
          ]
        }
      }
    }
  },
  "filters": [
    "dateRangeInvoice",
    "company",
    "party",
    "booker",
    "area",
    "section",
    "item",
    "invoice"
  ],
  "columns": [
    {
      "key": "date",
      "label": "Date"
    },
    {
      "key": "type",
      "label": "Type"
    },
    {
      "key": "booker",
      "label": "Booker"
    },
    {
      "key": "invoiceNo",
      "label": "Invoice",
      "link": "invoice"
    },
    {
      "key": "party",
      "label": "Party"
    },
    {
      "key": "company",
      "label": "Company"
    },
    {
      "key": "area",
      "label": "Area"
    },
    {
      "key": "section",
      "label": "Section"
    },
    {
      "key": "item",
      "label": "Item"
    },
    {
      "key": "qtyText",
      "label": "Qty",
      "right": true
    },
    {
      "key": "scheme",
      "label": "Free",
      "right": true
    },
    {
      "key": "final_amountText",
      "label": "Total",
      "right": true
    }
  ],
  "totals": [
    {
      "label": "Total Sale",
      "key": "sale"
    },
    {
      "label": "Total Returns",
      "key": "returns"
    },
    {
      "label": "Total",
      "key": "total"
    }
  ]
}
