{
  "title": "Payments By Company",
  "template": "page.html",
  "hub": {
    "title": "Payments By Company",
    "target": "paymentsbycompany",
    "tone": "red",
    "icon": "chart-area",
    "hub": "reports",
    "order": 3
  },
  "compute": {
    "report": "paymentsbycompany"
  },
  "spool": {
    "sql": "payments_by_company.sql",
    "row": [
      "id",
      "date",
      "type",
      "invoice",
      "originalInvoice",
      "area",
      "section",
      "company",
      "party",
      "booker",
      "amount",
      "amountText",
      "paid",
      "description",
      "type_code"
    ],
    "totals": {
      "cents": {
        "invoiceTotal": "CASE WHEN paid = 1 OR type_code = 2 THEN 0 ELSE amount END",
        "totalPaid": "CASE WHEN paid = 1 THEN amount ELSE 0 END",
        "recievingReturns": "CASE WHEN type_code = 2 THEN amount ELSE 0 END"
      },
      "derived": {
        "total": {
          "op": "-",
          "terms": [
            "invoiceTotal",
            "totalPaid",
            "recievingReturns"
          ]
        }
      }
    }
  },
  "filters": [
    {
      "name": "from",
      "label": "Date From",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "to",
      "label": "Date To",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "applyDate",
      "label": "Apply Date Filter",
      "type": "check",
      "default": true
    },
    {
      "name": "company",
      "label": "Company",
      "type": "select",
      "source": "companies"
    },
    {
      "name": "party",
      "label": "Party",
      "type": "select",
      "source": "parties"
    },
    {
      "name": "area",
      "label": "Area",
      "type": "select",
      "source": "areas"
    },
    {
      "name": "section",
      "label": "Section",
      "type": "select",
      "source": "sections"
    },
    {
      "name": "booker",
      "label": "Booker",
      "type": "select",
      "source": "order_bookers"
    }
  ],
  "columns": [
    {
      "key": "date",
      "label": "Date"
    },
    {
      "key": "type",
      "label": "Type"
    },
    {
      "key": "invoice",
      "label": "Invoice"
    },
    {
      "key": "area",
      "label": "Area"
    },
    {
      "key": "section",
      "label": "Section"
    },
    {
      "key": "company",
      "label": "Company"
    },
    {
      "key": "party",
      "label": "Party"
    },
    {
      "key": "booker",
      "label": "Booker"
    },
    {
      "key": "amountText",
      "label": "Amount",
      "right": true
    }
  ],
  "totals": [
    {
      "label": "Invoice Total",
      "key": "invoiceTotal"
    },
    {
      "label": "Returns",
      "key": "recievingReturns"
    },
    {
      "label": "Total Paid",
      "key": "totalPaid"
    },
    {
      "label": "Total",
      "key": "total"
    }
  ]
}
