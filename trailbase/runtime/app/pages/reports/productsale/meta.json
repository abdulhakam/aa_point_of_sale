{
  "title": "Product Sale Report",
  "template": "page.html",
  "hub": {
    "title": "Product Sale Report",
    "target": "productsale",
    "tone": "teal",
    "icon": "trolley",
    "hub": "reports",
    "order": 9
  },
  "compute": {
    "report": "productsale"
  },
  "spool": {
    "sql": "productsale.sql",
    "row": [
      "id",
      "name",
      "units",
      "amount",
      "box_size_qty",
      "box",
      "amountText",
      "qtyText"
    ],
    "totals": {
      "cents": {
        "amount": "amount"
      }
    }
  },
  "filters": [
    "dateRangeInvoice",
    "booker",
    "area",
    "section"
  ],
  "columns": [
    {
      "key": "name",
      "label": "Product Name"
    },
    {
      "key": "qtyText",
      "label": "Quantity (Ctn:Unit)",
      "right": true
    },
    {
      "key": "amountText",
      "label": "Amount",
      "right": true
    }
  ],
  "totals": [
    {
      "label": "Total",
      "key": "amount"
    }
  ]
}
