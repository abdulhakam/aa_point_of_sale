{
  "title": "Product Sale Report",
  "template": "page.html",
  "hub": {
    "title": "Product Sale Report",
    "target": "productsale",
    "tone": "teal",
    "icon": "trolley",
    "hub": "reports",
    "order": 9
  },
  "needs": {
    "views": [
      "transactionView",
      "refs"
    ]
  },
  "compute": {
    "report": "productsale"
  },
  "spool": {
    "sql": "productsale.sql",
    "row": [
      "id",
      "name",
      "units",
      "amount",
      "box_size_qty",
      "box",
      "amountText",
      "qtyText"
    ],
    "totals": {
      "cents": {
        "amount": "amount"
      }
    }
  },
  "filters": [
    {
      "name": "from",
      "label": "Date From",
      "type": "date",
      "default": {
        "source": "invoice"
      }
    },
    {
      "name": "to",
      "label": "Date To",
      "type": "date",
      "default": {
        "source": "invoice"
      }
    },
    {
      "name": "booker",
      "label": "Booker",
      "type": "select",
      "source": "order_bookers"
    },
    {
      "name": "area",
      "label": "Area",
      "type": "select",
      "source": "areas"
    },
    {
      "name": "section",
      "label": "Section",
      "type": "select",
      "source": "sections"
    }
  ],
  "columns": [
    {
      "key": "name",
      "label": "Product Name"
    },
    {
      "key": "qtyText",
      "label": "Quantity (Ctn:Unit)",
      "right": true
    },
    {
      "key": "amountText",
      "label": "Amount",
      "right": true
    }
  ],
  "totals": [
    {
      "label": "Total",
      "key": "amount"
    }
  ]
}
