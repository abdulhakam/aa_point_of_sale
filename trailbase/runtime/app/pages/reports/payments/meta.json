{
  "title": "Unified Payments Report",
  "template": "page.html",
  "hub": {
    "title": "Unified Payments Report",
    "target": "payments",
    "tone": "blue",
    "icon": "report-money",
    "hub": "reports",
    "order": 0
  },
  "needs": {
    "views": [
      "paymentsView",
      "invoiceView",
      "refs"
    ]
  },
  "compute": {
    "report": "payments"
  },
  "filters": [
    {
      "name": "from",
      "label": "Date From",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "to",
      "label": "Date To",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "party",
      "label": "Party",
      "type": "select",
      "source": "parties"
    },
    {
      "name": "area",
      "label": "Area",
      "type": "select",
      "source": "areas"
    },
    {
      "name": "section",
      "label": "Section",
      "type": "select",
      "source": "sections"
    },
    {
      "name": "booker",
      "label": "Booker",
      "type": "select",
      "source": "order_bookers"
    },
    {
      "name": "type",
      "label": "Payment Type",
      "type": "select",
      "source": "payment_types"
    },
    {
      "name": "invoice",
      "label": "Invoice #",
      "type": "text"
    }
  ],
  "columns": [
    {
      "key": "date",
      "label": "Date"
    },
    {
      "key": "type",
      "label": "Type"
    },
    {
      "key": "invoice",
      "label": "Inv #"
    },
    {
      "key": "area",
      "label": "Area"
    },
    {
      "key": "section",
      "label": "Section"
    },
    {
      "key": "party",
      "label": "Party"
    },
    {
      "key": "booker",
      "label": "Booker"
    },
    {
      "key": "amountText",
      "label": "Amount",
      "right": true
    }
  ],
  "totalsGroups": [
    [
      {
        "label": "Sales Amount",
        "key": "recieving"
      },
      {
        "label": "Recieved Amount",
        "key": "recieved"
      },
      {
        "label": "Returns",
        "key": "recievingReturns"
      },
      {
        "label": "Recivable Amount",
        "key": "totalRecieving"
      }
    ],
    [
      {
        "label": "Purchase Amount",
        "key": "sending"
      },
      {
        "label": "Paid Amount",
        "key": "sent"
      },
      {
        "label": "Returns",
        "key": "sendingReturns"
      },
      {
        "label": "Payable Amount",
        "key": "totalSending"
      }
    ]
  ]
}
