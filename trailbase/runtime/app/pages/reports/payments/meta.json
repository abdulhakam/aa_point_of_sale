{
  "title": "Unified Payments Report",
  "template": "page.html",
  "hub": {
    "title": "Unified Payments Report",
    "target": "payments",
    "tone": "blue",
    "icon": "report-money",
    "hub": "reports",
    "order": 0
  },
  "needs": {
    "views": [
      "paymentsView",
      "invoiceView",
      "refs"
    ]
  },
  "compute": {
    "report": "payments"
  },
  "spool": {
    "sql": "payments.sql",
    "row": [
      "id",
      "date",
      "type",
      "invoice",
      "invoiceId",
      "area",
      "section",
      "party",
      "booker",
      "amount",
      "amountText",
      "description",
      "paid",
      "type_code",
      "party_type"
    ],
    "totals": {
      "cents": {
        "recieving": "CASE WHEN type_code = 1 AND paid = 0 THEN amount ELSE 0 END",
        "recieved": "CASE WHEN type_code = 1 AND paid = 1 THEN amount ELSE 0 END",
        "sending": "CASE WHEN type_code = 0 AND paid = 0 THEN amount ELSE 0 END",
        "sent": "CASE WHEN type_code = 0 AND paid = 1 THEN amount ELSE 0 END",
        "recievingReturns": "CASE WHEN type_code = 2 THEN (CASE WHEN party_type = 0 THEN amount ELSE 0 END) ELSE 0 END",
        "sendingReturns": "CASE WHEN type_code = 2 THEN (CASE WHEN party_type = 0 THEN 0 ELSE amount END) ELSE 0 END",
        "invoiceTotal": "CASE WHEN paid = 1 THEN 0 ELSE amount END",
        "totalPaid": "CASE WHEN paid = 1 THEN amount ELSE 0 END"
      },
      "derived": {
        "totalRecieving": {
          "op": "-",
          "terms": [
            "recieving",
            "recieved",
            "recievingReturns"
          ]
        },
        "totalSending": {
          "op": "-",
          "terms": [
            "sending",
            "sent",
            "sendingReturns"
          ]
        },
        "total": {
          "op": "-",
          "terms": [
            "invoiceTotal",
            "totalPaid"
          ]
        }
      }
    }
  },
  "filters": [
    {
      "name": "from",
      "label": "Date From",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "to",
      "label": "Date To",
      "type": "date",
      "default": {
        "source": "payments"
      }
    },
    {
      "name": "party",
      "label": "Party",
      "type": "select",
      "source": "parties"
    },
    {
      "name": "area",
      "label": "Area",
      "type": "select",
      "source": "areas"
    },
    {
      "name": "section",
      "label": "Section",
      "type": "select",
      "source": "sections"
    },
    {
      "name": "booker",
      "label": "Booker",
      "type": "select",
      "source": "order_bookers"
    },
    {
      "name": "type",
      "label": "Payment Type",
      "type": "select",
      "source": "payment_types"
    },
    {
      "name": "invoice",
      "label": "Invoice #",
      "type": "text"
    }
  ],
  "columns": [
    {
      "key": "date",
      "label": "Date"
    },
    {
      "key": "type",
      "label": "Type"
    },
    {
      "key": "invoice",
      "label": "Inv #"
    },
    {
      "key": "area",
      "label": "Area"
    },
    {
      "key": "section",
      "label": "Section"
    },
    {
      "key": "party",
      "label": "Party"
    },
    {
      "key": "booker",
      "label": "Booker"
    },
    {
      "key": "amountText",
      "label": "Amount",
      "right": true
    }
  ],
  "totalsGroups": [
    [
      {
        "label": "Sales Amount",
        "key": "recieving"
      },
      {
        "label": "Recieved Amount",
        "key": "recieved"
      },
      {
        "label": "Returns",
        "key": "recievingReturns"
      },
      {
        "label": "Recivable Amount",
        "key": "totalRecieving"
      }
    ],
    [
      {
        "label": "Purchase Amount",
        "key": "sending"
      },
      {
        "label": "Paid Amount",
        "key": "sent"
      },
      {
        "label": "Returns",
        "key": "sendingReturns"
      },
      {
        "label": "Payable Amount",
        "key": "totalSending"
      }
    ]
  ]
}
