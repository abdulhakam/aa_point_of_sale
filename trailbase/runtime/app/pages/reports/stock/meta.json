{
  "title": "Stock Report",
  "template": "page.html",
  "hub": {
    "title": "Stock Report",
    "target": "stockreport",
    "tone": "green",
    "icon": "trolley",
    "hub": "reports",
    "order": 5
  },
  "needs": {
    "views": [
      "itemsReport",
      "refs"
    ]
  },
  "compute": {
    "report": "stockreport"
  },
  "spool": {
    "sql": "items.sql",
    "row": [
      "id",
      "company",
      "name",
      "cost_price",
      "sale_price",
      "qty",
      "box_size_qty",
      "qtyText",
      "costText",
      "stock_amount",
      "stockAmountText",
      "tone"
    ],
    "totals": {
      "cents": {
        "stockAmount": "stock_amount"
      }
    },
    "binds": {
      "agg": "stock"
    }
  },
  "filters": [
    {
      "name": "company",
      "label": "Company",
      "type": "select",
      "source": "companies"
    }
  ],
  "columns": [
    {
      "key": "company",
      "label": "Company"
    },
    {
      "key": "name",
      "label": "Name"
    },
    {
      "key": "costText",
      "label": "CP",
      "right": true
    },
    {
      "key": "qtyText",
      "label": "Qty",
      "right": true
    },
    {
      "key": "box_size_qty",
      "label": "Carton Size",
      "right": true
    },
    {
      "key": "stockAmountText",
      "label": "Stock Amount",
      "right": true
    }
  ],
  "totals": [
    {
      "label": "Total Stock",
      "key": "stockAmount"
    }
  ]
}
