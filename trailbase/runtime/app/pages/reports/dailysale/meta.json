{
  "title": "Daily Sale Report",
  "template": "page.html.jinja",
  "resetLabel": "RESET",
  "hub": {
    "title": "Daily Sale Report",
    "target": "dailysale",
    "tone": "indigo",
    "icon": "chart-bar",
    "hub": "reports",
    "order": 10
  },
  "compute": {
    "report": "dailysale"
  },
  "spool": {
    "sql": "dailysale.sql",
    "row": [
      "id",
      "invoiceNo",
      "party",
      "area",
      "booker",
      "total",
      "totalText",
      "party_id",
      "area_id",
      "booker_id"
    ],
    "totals": {
      "cents": {
        "total": "total"
      }
    }
  },
  "filters": [
    "dateRangeInvoice",
    "booker",
    "area",
    "section"
  ],
  "columns": [
    {
      "key": "invoiceNo",
      "label": "Invoice No"
    },
    {
      "key": "party",
      "label": "Customer Name"
    },
    {
      "key": "area",
      "label": "Area"
    },
    {
      "key": "booker",
      "label": "Booker"
    },
    {
      "key": "totalText",
      "label": "Total Amount",
      "right": true
    }
  ],
  "totals": [
    {
      "label": "Total",
      "key": "total"
    }
  ]
}
