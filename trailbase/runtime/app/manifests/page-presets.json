    "dateRangeInvoice": [
      { "name": "from", "label": "Date From", "type": "date", "default": { "source": "invoice" } },
      { "name": "to", "label": "Date To", "type": "date", "default": { "source": "invoice" } }
    ],
    "dateRangePayments": [
      { "name": "from", "label": "Date From", "type": "date", "default": { "source": "payments" } },
      { "name": "to", "label": "Date To", "type": "date", "default": { "source": "payments" } }
    ],
    "dateRangeGeneral": [
      { "name": "from", "label": "Date From", "type": "date", "default": { "fn": "monthStart" } },
      { "name": "to", "label": "Date To", "type": "date", "default": { "fn": "today" } }
    ],
    "company": { "name": "company", "label": "Company", "type": "select", "source": "companies" },
    "party": { "name": "party", "label": "Party", "type": "select", "source": "parties" },
    "booker": { "name": "booker", "label": "Booker", "type": "select", "source": "order_bookers" },
    "area": { "name": "area", "label": "Area", "type": "select", "source": "areas" },
    "section": { "name": "section", "label": "Section", "type": "select", "source": "sections" },
