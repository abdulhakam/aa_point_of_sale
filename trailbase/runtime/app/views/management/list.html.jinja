{% extends 'layout.html.jinja' %}
{% import 'partials/entity_fields.html.jinja' as ef %}
{% import 'partials/icons.html.jinja' as icons %}
{% block body %}
{# ⚠️ The list page is the legacy screen: a bare filter row and a table, no heading, no count badge,
   no card wrappers ([[tb-0023-guest-feature-parity]] items A and C). The create/edit form is a
   separate affordance (`?new=1`, or a row's pencil) and only then is a panel shown. #}
{% if isNew or editRow or viewRow %}
<section class="card">
  <h2>{% if viewRow %}View {{ entity.singular }}{% elif editRow %}Edit {{ entity.singular }}{% else %}New {{ entity.singular }}{% endif %}</h2>
  {# `hx-boost` submits through htmx using the form's own action/method, and the server answers an htmx
     write with the list fragment (see the management write routes), so a save swaps `#app-main` and
     closes the panel without a document reload. Without htmx the form POSTs and 303s as before. #}
  {# `hx-push-url` is the LIST url, not `false`: after a save the address bar shows the list rather than
     the POST action or a lingering `?new=1`, so a refresh reloads the list. #}
  <aa-entity-form>
  <form class="entity-form" method="post" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="/management/{{ entityKey }}" action="{% if editRow %}/management/{{ entityKey }}/{{ editRow.id }}/update{% elif viewRow %}/management/{{ entityKey }}{% else %}/management/{{ entityKey }}/create{% endif %}">
    {{ ef.render(fields) }}
    <div class="form-actions">
      {% if viewRow %}
      {# Read-only: `formFields` disabled every field, so there is nothing to submit — only a way back. #}
      <a class="btn" href="/management/{{ entityKey }}">Back to list</a>
      {% else %}
      <button class="btn primary" type="submit">{% if editRow %}Save{% else %}Create{% endif %}</button>
      <a class="btn" href="/management/{{ entityKey }}">Cancel</a>
      {% endif %}
    </div>
  </form>
  </aa-entity-form>
</section>
{% endif %}

<div class="mgmt-toolbar">
  <label class="field"><span>Search</span><input type="search" data-table-filter="#mgmt-table" autocomplete="off"></label>
  <a class="btn primary" href="/management/{{ entityKey }}?new=1">add new</a>
</div>
<div class="tablewrap">
<table class="data" id="mgmt-table" data-mobile="cards" data-sortable>
  <thead><tr>
    {% for c in columns %}<th class="{{ c.align }}" data-sort="{{ c.key }}"><button type="button" class="th-sort">{{ c.label }}</button></th>{% endfor %}
    <th class="right">Row actions</th>
  </tr></thead>
  <tbody>
  {% for r in rows %}
    <tr{% if editRow and editRow.id == r.id %} class="editing"{% endif %}>
      {% for c in columns %}<td class="{{ c.align }}" data-label="{{ c.label }}"{% if loop.first %} data-lead{% endif %}>{{ r.cells[c.key] }}</td>{% endfor %}
      <td class="row-actions" data-label="Row actions">
        <a class="icon-view" href="/management/{{ entityKey }}?view={{ r.id }}" title="View">{{ icons.svg('eye', 16) }}</a>
        <a class="icon-edit" href="/management/{{ entityKey }}?edit={{ r.id }}" title="Edit">{{ icons.svg('pencil', 16) }}</a>
        {# `hx-confirm` is htmx's own confirm (window.confirm), replacing `data-confirm` here so the
           cancel happens BEFORE the request rather than as a listener racing htmx's submit. #}
        <form method="post" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="false" hx-confirm="Delete this record?" action="/management/{{ entityKey }}/{{ r.id }}/delete">
          <button class="icon-del" type="submit" title="Delete">{{ icons.svg('trash', 16) }}</button>
        </form>
      </td>
    </tr>
  {% else %}
    <tr><td class="empty" colspan="{{ columns|length + 1 }}">No records yet.</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endblock %}
