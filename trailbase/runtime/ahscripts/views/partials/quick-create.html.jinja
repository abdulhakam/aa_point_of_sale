{# Quick-create dialogs: a party or an item made without leaving the invoice.
   ================================================================================

   A real dialog, as the legacy app has: the combobox's "Create …" row opens a centered modal with its
   own fields and its OWN submit. With JavaScript the submit is intercepted and POSTs `/quick-create`,
   so the row is inserted into the cached reference list and selected in the control that opened the
   dialog — no reload, no lost edits ([[reference-lists-come-from-indexeddb]]). The `<aa-modal>`
   component moves the authored form into the overlay, so with no JavaScript the form stays a normal
   (hidden) inline block and nothing is invented.

   The controls are DISABLED while the dialog is closed. Hidden is not enough — a hidden input is still
   submitted, so an abandoned create must not carry the typed name into a save. `autocomplete.js`
   enables them when it opens the dialog and disables them again on close.

   ⚠️ There is deliberately no `required` in this markup. A hidden, required input still blocks form
   submission — the browser validates it even though nobody can see it. The combobox sets `required`
   on the name when it opens the dialog, and the server checks it again. #}

{% macro party(type, areas) -%}
<aa-modal title="{% if type == 0 %}Create New Supplier{% else %}Create New Customer{% endif %}" id="qc-party-modal">
<div class="qc" id="qc-party" hidden>
  {# The INVOICE's type, not the party's — a purchase (0) makes a supplier and everything else a
     customer, and `lib/quick-create.js` is the one place that translation lives. #}
  <form method="post" action="/quick-create">
    <input type="hidden" name="kind" value="party">
    <input type="hidden" name="party_new_from_invoice_type" value="{{ type }}">
    <div class="qc-fields">
      <label class="field"><span>Name</span><input type="text" name="party_new_name" autocomplete="off" spellcheck="false"></label>
      <label class="field"><span>Area</span>
        <select name="party_new_area" data-searchable data-ref="areas">
          <option value="">No area</option>
          {% for a in areas %}<option value="{{ a.id }}">{{ a.name }}</option>{% endfor %}
        </select>
      </label>
      <label class="field"><span>Phone</span><input type="text" name="party_new_phone" autocomplete="off" spellcheck="false"></label>
      <label class="field"><span>Address</span><input type="text" name="party_new_address" autocomplete="off" spellcheck="false"></label>
    </div>
    <div class="form-actions">
      {# `data-qc-create` is the hook refdb-create.js uses to POST /quick-create and inject the row
         without a reload. #}
      <button class="btn primary" type="submit" data-qc-create>Create party</button>
      <button class="btn" type="button" data-qc-cancel>Cancel</button>
    </div>
  </form>
</div>
</aa-modal>
{%- endmacro %}

{% macro item(companies) -%}
<aa-modal title="Create New Item" id="qc-item-modal">
<div class="qc" id="qc-item" hidden>
  <form method="post" action="/quick-create">
    <input type="hidden" name="kind" value="item">
    <div class="qc-fields">
      <label class="field"><span>Name</span><input type="text" name="item_new_name" autocomplete="off" spellcheck="false"></label>
      <label class="field"><span>Company</span>
        <select name="item_new_category" data-searchable data-ref="companies">
          <option value="">No company</option>
          {% for c in companies %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
        </select>
      </label>
      <label class="field"><span>Cost Price</span><aa-money rate><input type="number" step="any" name="item_new_cost_price" value="0"></aa-money></label>
      <label class="field"><span>Sale Price</span><aa-money rate><input type="number" step="any" name="item_new_sale_price" value="0"></aa-money></label>
      <label class="field"><span>Carton Size</span><input type="number" step="any" name="item_new_box_size_qty" value="0"></label>
    </div>
    <div class="form-actions">
      {# Creates the item and selects it; the line is then added by the form's own ADD LINE, so the
         numbers the operator sets win. See refdb-create.js. #}
      <button class="btn primary" type="submit" data-qc-create>Create item</button>
      <button class="btn" type="button" data-qc-cancel>Cancel</button>
    </div>
  </form>
</div>
</aa-modal>
{%- endmacro %}
