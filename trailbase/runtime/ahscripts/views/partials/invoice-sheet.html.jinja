{# The invoice sheet body, as a macro so the single-invoice view (`invoices/{id}/view/page.html.jinja`) and the
   queued batch (`print/queue.html.jinja`) render from ONE source. Pass the `data` object that
   `app/lib/invoice-sheet.js` returns.

   The screen and the printout are the same artefact: printing is a stylesheet over this, not a
   second renderer. Mirrors the LEGACY print (`/app/invoices/print?invoiceId=…`) — the centred
   business header with `PRINT TIME:`, the `<type> INVOICE` title, the Party/Address/Booker/Remarks
   block beside the boxed Invoice #/Date/Time block, the legacy line columns (BOX SIZE,
   CTN/UNTS/FREE, UNIT/CTN price, TOTAL), the legacy totals labels (TOTAL AMOUNT, DISCOUNT 1/2,
   DISCOUNT cash, PAYABLE AMOUNT) and the Checked By / Delivered By footer.

   The header and footer are repeated on EVERY printed page, as the legacy sheet is: each is
   `position: fixed` for print and offset into the page margin, and the A5 `@page` margin (applied to
   every page) reserves their band. Both are hidden on screen. #}
{% macro sheet(d) %}
<article class="invoice-doc" data-invoice-doc>
  <header class="doc-print-head">
    {# Left cell: the optional business logo (business.json `logo`). Empty draws nothing, which is the
       default and what the legacy sheet had. #}
    <div class="dph-cell">{% if d.businessLogo %}<img class="doc-logo" src="{{ d.businessLogo }}" alt="">{% endif %}</div>
    <div class="dph-cell dph-center">
      <div class="dph-business">{{ d.businessName }}</div>
      <div class="dph-line">{{ d.businessAddress }}</div>
      <div class="dph-line">Contact: {{ d.businessPhone }}</div>
    </div>
    <div class="dph-cell dph-printtime">
      <div>PRINT TIME:</div>
      <div>{{ d.nowTime }}</div>
      <div>{{ d.nowDate }}</div>
    </div>
  </header>

  <h3 class="doc-type">{{ d.typeLabel }}</h3>

  {# Legacy: the left block carries Party (bold name + phone), then Address and Booker on a SALE
     invoice only, then Remarks; the right block carries the boxed Invoice #, the date and the time. #}
  <section class="doc-parties">
    <table class="doc-info doc-info-left">
      <tr><th>Party</th><td><b>{{ d.partyName }}</b> ({{ d.partyPhone }})</td></tr>
      {% if d.partyAddress %}<tr><th>Address</th><td>{{ d.partyAddress }}</td></tr>{% endif %}
      {% if d.bookerName %}<tr><th>Booker</th><td>{{ d.bookerName }} ({{ d.bookerPhone }})</td></tr>{% endif %}
      <tr><th>Remarks</th><td>{{ d.remarks }}</td></tr>
    </table>
    <table class="doc-info doc-info-right">
      <tr><th>Invoice #:</th><td><span class="doc-invno">{{ d.invoiceNo }}</span></td></tr>
      <tr><th>Invoice Date:</th><td>{{ d.invDate }}</td></tr>
      <tr><th>Invoice Time:</th><td>{{ d.invTime }}</td></tr>
    </table>
  </section>

  <hr class="doc-rule"/>

  {# Legacy column layout: BOX SIZE, QUANTITY (CTN / UNTS / FREE), PRICES (UNIT / CTN),
     [DISCOUNTS (1(%) / 2(%) / IN RS)], TOTAL — TOTAL is the LAST column, after the discount group.
     CTN price is box size x unit price, which is the figure the legacy sheet prints. The legacy
     headers are upper-case literals. #}
  <table class="data doc-lines">
    <thead>
      <tr>
        <th rowspan="2">#</th><th rowspan="2">ITEM</th><th rowspan="2" class="right">BOX SIZE</th>
        <th colspan="3" class="center">QUANTITY</th>
        <th colspan="2" class="right">PRICES</th>
        {# Legacy order: the DISCOUNTS group sits BEFORE TOTAL, and TOTAL is the last column. The
           group is added only when some line carries a discount. #}
        {% if d.hasLineDiscounts %}<th colspan="3" class="right">DISCOUNTS</th>{% endif %}
        <th rowspan="2" class="right">TOTAL</th>
      </tr>
      <tr>
        <th class="right">CTN</th><th class="right">UNTS</th><th class="right">FREE</th>
        <th class="right">UNIT</th><th class="right">CTN</th>
        {% if d.hasLineDiscounts %}<th class="right">1(%)</th><th class="right">2(%)</th><th class="right">IN RS</th>{% endif %}
      </tr>
    </thead>
    <tbody>
    {% for l in d.lines %}
      <tr>
        <td data-label="#">{{ l.index }}</td>
        <td data-label="ITEM" data-lead>{{ l.itemName }}</td>
        <td class="right" data-label="BOX SIZE">{{ l.boxSize }}</td>
        <td class="right" data-label="CTN">{{ l.ctn }}</td>
        <td class="right" data-label="UNTS">{{ l.units }}</td>
        <td class="right" data-label="FREE">{{ l.free }}</td>
        <td class="right" data-label="UNIT">{{ l.unitPrice }}</td>
        <td class="right" data-label="CTN">{{ l.ctnPrice }}</td>
        {% if d.hasLineDiscounts %}<td class="right" data-label="1(%)">{{ l.d1Text }}</td><td class="right" data-label="2(%)">{{ l.d2Text }}</td><td class="right" data-label="IN RS">{{ l.drsText }}</td>{% endif %}
        <td class="right" data-label="TOTAL">{{ l.total }}</td>
      </tr>
    {% else %}
      <tr><td class="empty" colspan="{% if d.hasLineDiscounts %}12{% else %}9{% endif %}">This document has no lines.</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <section class="doc-totals">
    <div class="doc-totals-inner">
      {% if d.dueDate %}<div class="doc-due"><b>Due Date:</b> {{ d.dueDate }}</div>{% endif %}
      <table class="doc-total-table">
        <tr><th>TOTAL AMOUNT</th><td class="right"><b>{{ d.totals.totalAmountText }}</b></td></tr>
        <tr><th>DISCOUNT 1</th><td class="right">{{ d.totals.d1Text }}</td></tr>
        <tr><th>DISCOUNT 2</th><td class="right">{{ d.totals.d2Text }}</td></tr>
        <tr><th>DISCOUNT cash</th><td class="right">{{ d.totals.cashText }}</td></tr>
        <tr><th>PAYABLE AMOUNT</th><td class="right"><b>{{ d.totals.payableText }}</b></td></tr>
      </table>
    </div>
  </section>

  <footer class="doc-foot">
    <div>
      <div>Checked By: ABDUL MAJID</div>
      <div>000-0000000</div>
    </div>
    <div class="doc-foot-right">
      <div>Delivered By: OSAMA</div>
      <div>0315-3730881</div>
    </div>
  </footer>
</article>
{% endmacro %}

