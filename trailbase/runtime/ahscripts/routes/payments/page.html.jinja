{% extends 'layout.html.jinja' %}
{% block body %}
<h1 class="page-title">Payments</h1>

<div class="pagebar">
  <a class="btn primary" href="/payments/new">+ New Payment</a>
  <a class="btn" href="/reports/outstanding">Outstanding report</a>
</div>

{# APPLY is an htmx fragment: it swaps the list into `#app-main` and pushes the filtered URL, so a
   filter result is shareable and the shell is not re-rendered (see [[htmx-navigation-with-html-fragments]]). #}
<form class="filters" method="get" hx-get="/payments" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="true" action="/payments">
  <label class="field"><span>Date From</span><input type="date" name="from" value="{{ filters.from }}"></label>
  <label class="field"><span>Date To</span><input type="date" name="to" value="{{ filters.to }}"></label>
  <label class="field"><span>Select Section</span>
    <select name="section" data-searchable data-ref="sections">
      <option value="">All</option>
      {% for s in sections %}<option value="{{ s.id }}"{% if filters.section == s.id %} selected{% endif %}>{{ s.name }}</option>{% endfor %}
    </select>
  </label>
  <label class="field"><span>Select Area</span>
    <select name="area" data-searchable data-ref="areas">
      <option value="">All</option>
      {% for a in areas %}<option value="{{ a.id }}"{% if filters.area == a.id %} selected{% endif %}>{{ a.name }}</option>{% endfor %}
    </select>
  </label>
  <label class="field"><span>Select Booker</span>
    <select name="booker" data-searchable data-ref="order_bookers">
      <option value="">All</option>
      {% for b in bookers %}<option value="{{ b.id }}"{% if filters.booker == b.id %} selected{% endif %}>{{ b.name }}</option>{% endfor %}
    </select>
  </label>
  <label class="field"><span>Select Party</span>
    <select name="party" data-searchable data-ref="parties">
      <option value="">All</option>
      {% for p in parties %}<option value="{{ p.id }}"{% if filters.party == p.id %} selected{% endif %}>{{ p.name }}</option>{% endfor %}
    </select>
  </label>
  <label class="field"><span>Select Payment Type</span>
    <select name="type">
      <option value="">All</option>
      {% for t in types %}<option value="{{ t.code }}"{% if selectedType == t.code %} selected{% endif %}>{{ t.label }}</option>{% endfor %}
    </select>
  </label>
  <label class="field check"><input type="checkbox" name="standalone"{% if filters.standalone %} checked{% endif %}> <span>DA only (no invoice)</span></label>
  <label class="field check"><input type="checkbox" name="open"{% if filters.open %} checked{% endif %}> <span>Open entries only</span></label>
  <div class="filter-actions">
    <button class="btn primary" type="submit">APPLY</button>
    <a class="btn" href="/payments">RESET</a>
  </div>
</form>

<section class="card">
  <div class="list-toolbar">
    <h2>Payments ({{ totals.count }})</h2>
    <div class="stat-grid">
      <div class="stat"><div class="stat-value">{{ totals.recievedText }}</div><div class="stat-label">Recieved</div></div>
      <div class="stat"><div class="stat-value">{{ totals.sentText }}</div><div class="stat-label">Sent</div></div>
      <div class="stat"><div class="stat-value">{{ totals.netText }}</div><div class="stat-label">Net</div></div>
    </div>
  </div>
  <div class="tablewrap">
  <table class="data" data-mobile="cards">
    <thead><tr>
      <th>Date</th><th>Type</th><th>Invoice</th><th>Original invoices</th><th>Area</th>
      <th>Section</th><th>Party</th><th>Booker</th><th class="right">Amount</th><th class="right">Row actions</th>
    </tr></thead>
    <tbody>
    {% for r in rows %}
      <tr>
        <td data-label="Date" data-lead>{{ r.date }}</td>
        <td data-label="Type">{{ r.typeLabel }}</td>
        <td data-label="Invoice">{% if r.standalone %}<span class="muted">DA</span>{% else %}<a href="/invoices/{{ r.invoice }}">{{ r.invoiceNo }}</a>{% endif %}</td>
        <td data-label="Original invoices">{{ r.originalInvoiceNo or "" }}</td>
        <td data-label="Area">{{ r.area }}</td>
        <td data-label="Section">{{ r.section }}</td>
        <td data-label="Party">{{ r.partyName }}{% if r.paidTo %} → {{ r.paidTo }}{% endif %}</td>
        <td data-label="Booker">{{ r.booker }}</td>
        <td class="right" data-label="Amount">{{ r.amountText }}</td>
        <td class="row-actions" data-label="">
          <form method="post" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="false" hx-confirm="Delete this payment?" action="/payments/{{ r.id }}/delete">
            <button class="icon-del" type="submit" title="Delete">×</button>
          </form>
        </td>
      </tr>
    {% else %}
      <tr><td class="empty" colspan="10">No payments match these filters.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if rowInfo.truncated %}
  <p class="notice">Showing the first {{ rowInfo.shown }} of {{ rowInfo.total }} payments. <a href="{{ rowInfo.allHref }}" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML">Show all</a></p>
  {% endif %}
</section>
{% endblock %}
