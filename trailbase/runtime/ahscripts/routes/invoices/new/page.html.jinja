{% extends 'layout.html.jinja' %}
{% import 'partials/icons.html.jinja' as icons %}
{% import 'partials/quick-create.html.jinja' as qc %}
{% block body %}
{# The keyboard invoice console — the single keyboard-first surface that IS the invoice.
   See .kilo/plans/1791600000000-invoice-view-keyboard-redesign.md and
   vault/decisions/invoice-console-keyboard-state-machine.md.

   The keyboard is an accelerator over markup that already works: every key action here also has a
   visible button, and with no JavaScript the forms still post (create / header / add line / complete /
   delete) exactly as the entry and grid screens did. `invoices/{id}/grid/page.html.jinja` at `/invoices/<id>/grid` stays the
   no-JS power fallback.

   `data-state` is the state machine's starting state: `pick` (State 0, nothing open) or `open`
   (an invoice is loaded). The component (`components/invoice-view.js`) drives focus and the walk. #}
{% set state = 'open' if not isNew else 'pick' %}
<aa-invoice-view data-type="{{ type }}" data-state="{{ state }}"
                 data-can-write="{{ '1' if (not isNew and invoice.canWrite) else '0' }}"
                 data-invoice="{{ invoice.id if invoice else '' }}"
                 data-payment-hint="{{ 0 if type == 0 else 1 }}">

<h1 class="inv-type-title">{{ (typeLabel if isNew else invoice.typeLabel)|upper }} INVOICE</h1>
<hr class="inv-rule">

{% if message %}<div class="notice" data-state="{{ 'error' if status == 'error' else 'ok' }}" data-console-flash>{{ message }}</div>{% endif %}

{# ── State 0 / the top control: the invoice # picker ─────────────────────────────────────────────
   A searchable select of `NEW` + this type's invoices. The server renders the newest 200 as the
   initial list; `public/js/invoice-remote.js` replaces them with server-side number matches as the
   operator types (`data-invoice-remote`), so any invoice number is reachable. State 0 focuses it with
   `NEW` selected. Choosing an invoice opens the action dialog (State E); `0` then Enter exits. #}
<form class="console-pick" method="get" action="/invoices/new" data-console-pick>
  <input type="hidden" name="type" value="{{ type }}">
  <label class="ih-field"><span>INVOICE #</span>
    <select name="invoice" data-searchable data-force-combo data-ac-limit="200" data-console-picker data-invoice-remote="/data/invoices/search?type={{ type }}" aria-label="Invoice number">
      <option value=""{% if isNew %} selected{% endif %}>NEW</option>
      {% for p in picker %}
      <option value="{{ p.id }}"{% if invoice and invoice.id == p.id %} selected{% endif %}>{{ p.label }}</option>
      {% endfor %}
    </select>
  </label>
  <button class="btn" type="submit">Open</button>
</form>

{% if isNew %}
{# ── States 1–4: the NEW walk. All disabled until the walk enables them (State 0). ─────────────── #}
<aa-entity-form>
<form class="invoice-head" method="post" action="/invoices/new" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="false" data-console-create>
  <input type="hidden" name="type" value="{{ type }}">
  <input type="hidden" name="surface" value="console">
  <input type="hidden" name="key" value="{{ opKey }}">
  <label class="ih-field"><span>INVOICE NO:</span><input type="text" value="new" readonly tabindex="-1"></label>
  <label class="ih-field"><span>INVOICE DATE</span><aa-date-input><input type="date" name="dated" value="{{ today }}" disabled></aa-date-input></label>
  {% if type == 1 %}
  <label class="ih-field"><span>BOOKER</span>
    <select name="booker" data-searchable data-ref="bookers" disabled>
      <option value="">No booker</option>
      {% for b in bookers %}<option value="{{ b.id }}">{{ b.name }}</option>{% endfor %}
    </select>
  </label>
  {% endif %}
  {% if type != 3 %}
  <label class="ih-field"><span>{{ 'SUPPLIER' if type == 0 else ('PARTY' if type == 2 else 'CUSTOMER') }}</span>
    <span class="ih-with-add">
      <select name="party" data-searchable data-ref="parties" data-create="#qc-party" disabled>
        <option value="">No party</option>
        {% for p in parties %}<option value="{{ p.id }}">{{ p.label }}</option>{% endfor %}
      </select>
      <button class="ih-add" type="button" data-qc-open="#qc-party" title="Create New Customer">+</button>
    </span>
  </label>
  {% endif %}
  {% if type == 2 %}
  <label class="ih-field"><span>Original Invoice</span><input type="text" name="original_invoice" autocomplete="off" disabled></label>
  {% endif %}
  <label class="ih-field"><span>USER:</span><input type="text" value="{{ user.name }}" disabled></label>
  <button class="btn primary ih-go" type="submit" data-console-go>Create</button>
</form>
</aa-entity-form>
{# The create dialog is OUTSIDE the header form (a form inside a form is invalid HTML). #}
{{ qc.party(type, areas) }}
{% else %}

{# ── State 4 onward: the OPEN invoice. Header + line area. ─────────────────────────────────────── #}
<aa-entity-form>
<form class="invoice-head" method="post" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="false" action="/invoices/{{ invoice.id }}/header" data-console-header>
  <input type="hidden" name="surface" value="console">
  <label class="ih-field"><span>INVOICE NO:</span><input type="text" value="{{ invoice.invoiceNo }}" readonly tabindex="-1"></label>
  <label class="ih-field"><span>INVOICE DATE</span><aa-date-input><input type="date" name="dated" value="{{ invoice.dated }}"{% if not invoice.canWrite %} disabled{% endif %}></aa-date-input></label>
  {% if type == 1 %}
  <label class="ih-field"><span>BOOKER</span>
    <select name="booker" data-searchable data-ref="bookers"{% if not invoice.canWrite %} disabled{% endif %}>
      <option value="">No booker</option>
      {% for b in bookers %}<option value="{{ b.id }}"{% if invoice.booker == b.id %} selected{% endif %}>{{ b.name }}</option>{% endfor %}
    </select>
  </label>
  {% endif %}
  {% if type != 3 %}
  <label class="ih-field"><span>{{ 'SUPPLIER' if type == 0 else ('PARTY' if type == 2 else 'CUSTOMER') }}</span>
    <span class="ih-with-add">
      <select name="party" data-searchable data-ref="parties" data-create="#qc-party"{% if not invoice.canWrite %} disabled{% endif %}>
        <option value="">No party</option>
        {% for p in parties %}<option value="{{ p.id }}"{% if invoice.party == p.id %} selected{% endif %}>{{ p.label }}</option>{% endfor %}
      </select>
      {% if invoice.canWrite %}<button class="ih-add" type="button" data-qc-open="#qc-party" title="Create New Customer">+</button>{% endif %}
    </span>
  </label>
  {% endif %}
  {% if type == 2 %}
  <label class="ih-field"><span>Original Invoice</span><input type="text" name="original_invoice" autocomplete="off"{% if not invoice.canWrite %} disabled{% endif %}></label>
  {% endif %}
  <label class="ih-field"><span>USER:</span><input type="text" value="{{ user.name }}" disabled></label>
  {% if invoice.canWrite %}<button class="btn primary ih-go" type="submit">Save</button>{% endif %}
  <a class="ih-print" href="/invoices/{{ invoice.id }}/view?print=1&amp;source=live" title="Print" target="_blank" rel="noopener">{{ icons.svg('printer', 20) }}</a>

  <div class="ih-row2">
    <label class="ih-field wide"><span>Description</span><input type="text" name="description" value="{{ invoice.description }}" autocomplete="off"{% if not invoice.canWrite %} disabled{% endif %}></label>
    <label class="ih-field"><span>Discount %</span><aa-money rate><input type="number" step="any" name="discount_1" value="{{ invoice.discount1 }}" data-inv-discount{% if not invoice.canWrite %} disabled{% endif %}></aa-money></label>
    <label class="ih-field"><span>Discount 2 %</span><aa-money rate><input type="number" step="any" name="discount_2" value="{{ invoice.discount2 }}" data-inv-discount{% if not invoice.canWrite %} disabled{% endif %}></aa-money></label>
    <label class="ih-field"><span>Discount Rs</span><aa-money><input type="number" step="0.01" name="discount_rs" value="{{ invoice.discountRs }}" data-inv-discount{% if not invoice.canWrite %} disabled{% endif %}></aa-money></label>
  </div>
</form>
</aa-entity-form>
{{ qc.party(type, areas) }}

<div class="pagebar">
  <a class="btn" href="/invoices">← Invoices</a>
  {% if invoice.canWrite %}
  <button class="btn" type="button" data-console-edit>Edit lines</button>
  <a class="btn" href="/payments/new?invoice={{ invoice.id }}&amp;type={{ 0 if type == 0 else 1 }}&amp;party={{ invoice.party }}&amp;amount={{ invoice.balanceText }}">+ PAYMENT</a>
  <button class="btn" type="button" data-console-view>View (latest)</button>
  <button class="btn" type="button" data-console-print>Print</button>
  <form method="post" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="false" action="/invoices/{{ invoice.id }}/delete" style="display:inline" data-console-delete onsubmit="return confirm('Delete invoice #{{ invoice.invoiceNo }}?')">
    <input type="hidden" name="surface" value="console">
    <button class="btn danger" type="submit">Delete</button>
  </form>
  {% endif %}
</div>

<section class="card">
  <h2>Lines</h2>
  {# The keyboard add-line walk (item → carton → unit → free → discounts) is wired to these fields by
     the component; Enter submits the form to `/invoices/<id>/line` (one line, the canonical
     `appendLine`). #}
  {% if invoice.canWrite %}
  <aa-entity-form>
  <form class="entity-form" method="post" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="false" action="/invoices/{{ invoice.id }}/line" data-console-lineform>
    <input type="hidden" name="surface" value="console">
    <input type="hidden" name="opKey" value="{{ opKey }}">
    <label class="field"><span>Item</span>
      <select name="item" data-searchable data-ref="items" data-create="#qc-item" data-adv-search data-force-combo data-console-item required>
        <option value="">Choose an item…</option>
        {% for it in items %}<option value="{{ it.id }}" data-price="{{ it.price }}" data-cost="{{ it.costPrice }}" data-box="{{ it.boxSizeQty }}">{{ it.name }}</option>{% endfor %}
      </select>
    </label>
    <label class="field"><span>Carton size</span><input type="number" step="any" name="box_size_qty" value="0" data-console-box></label>
    <label class="field"><span>Qty (units)</span><input type="number" step="any" name="qty" value="1" data-console-qty></label>
    <label class="field"><span>Free</span><input type="number" step="any" name="scheme" value="0" data-console-free></label>
    <label class="field"><span>Price</span><aa-money rate><input type="number" step="any" name="price" value="0" data-console-price></aa-money></label>
    <label class="field"><span>Discount 1 %</span><aa-money rate><input type="number" step="any" name="discount_1" value="0" data-console-d1></aa-money></label>
    <label class="field"><span>Discount 2 %</span><aa-money rate><input type="number" step="any" name="discount_2" value="0" data-console-d2></aa-money></label>
    <label class="field"><span>Discount Rs</span><aa-money><input type="number" step="0.01" name="discount_rs" value="0" data-console-drs></aa-money></label>
    <div class="form-actions"><button class="btn primary" type="submit">ADD LINE</button></div>
  </form>
  </aa-entity-form>
  {{ qc.item(companies) }}
  {% endif %}

  <div class="tablewrap">
  <table class="data" data-mobile="cards" data-console-lines>
    <thead><tr>
      <th>Item</th><th class="right">Qty</th><th class="right">Price</th>
      <th class="right">D1 %</th><th class="right">D2 %</th><th class="right">Disc Rs</th>
      <th class="right">Free</th><th class="right">Amount</th>{% if invoice.canWrite %}<th class="right">Actions</th>{% endif %}
    </tr></thead>
    <tbody>
    {% for l in invoice.lines %}
      <tr data-console-line data-line="{{ l.id }}"{% if l.deleted %} class="neg"{% endif %}>
        <td data-label="Item" data-lead>{{ l.itemName }}</td>
        <td class="right" data-label="Qty"><input type="number" step="any" class="cell" name="qty" value="{{ l.qtyText }}"{% if not invoice.canWrite %} disabled{% endif %}></td>
        <td class="right" data-label="Price"><aa-money rate><input type="number" step="any" class="cell" name="price" value="{{ l.priceText }}"{% if not invoice.canWrite %} disabled{% endif %}></aa-money></td>
        <td class="right" data-label="D1 %"><aa-money rate><input type="number" step="any" class="cell" name="discount_1" value="{{ l.discount1 }}"{% if not invoice.canWrite %} disabled{% endif %}></aa-money></td>
        <td class="right" data-label="D2 %"><aa-money rate><input type="number" step="any" class="cell" name="discount_2" value="{{ l.discount2 }}"{% if not invoice.canWrite %} disabled{% endif %}></aa-money></td>
        <td class="right" data-label="Disc Rs"><aa-money><input type="number" step="0.01" class="cell" name="discount_rs" value="{{ l.discountRs }}"{% if not invoice.canWrite %} disabled{% endif %}></aa-money></td>
        <td class="right" data-label="Free"><input type="number" step="any" class="cell" name="scheme" value="{{ l.scheme }}"{% if not invoice.canWrite %} disabled{% endif %}></td>
        <td class="right" data-label="Amount" data-amount>{{ l.amountText }}</td>
        {% if invoice.canWrite %}
        <td class="row-actions" data-label="Actions">
          <form method="post" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="false" hx-confirm="Remove this line?" action="/invoices/{{ invoice.id }}/line/{{ l.id }}/delete">
            <input type="hidden" name="surface" value="console">
            <button class="icon-del" type="submit" title="Remove">{{ icons.svg('trash', 16) }}</button>
          </form>
        </td>
        {% endif %}
      </tr>
    {% else %}
      <tr><td class="empty" colspan="9">No lines yet. Press Enter on the item field to add one.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <div class="totals">
    <table class="totals-table">
      <tr><th>Lines</th><td class="right">{{ invoice.lineTotalText }}</td></tr>
      <tr><th>Total</th><td class="right" data-console-total>{{ invoice.totalText }}</td></tr>
      <tr><th>Paid</th><td class="right">{{ invoice.paidText }}</td></tr>
      <tr><th>{% if invoice.creditDue %}Credit due{% else %}Balance{% endif %}</th><td class="right">{{ invoice.balanceText }}</td></tr>
    </table>
  </div>
</section>

{# ── State E: the existing-invoice action dialog. Buttons for every key action. ────────────────── #}
<aa-modal id="console-actions" title="Invoice #{{ invoice.invoiceNo }}"{% if actionsOpen %} open{% endif %}>
  <p class="muted">1 Edit · 2 View · 3 Payment · 4 Print · Esc Close</p>
  <div class="pagebar">
    <a class="btn primary" href="/invoices/new?type={{ type }}&amp;invoice={{ invoice.id }}">1 Edit lines</a>
    <a class="btn" href="/invoices/{{ invoice.id }}/view?source=live" data-console-view-live>2 View</a>
    <a class="btn" href="/payments/new?invoice={{ invoice.id }}&amp;type={{ 0 if type == 0 else 1 }}&amp;party={{ invoice.party }}&amp;amount={{ invoice.balanceText }}">3 Payment</a>
    <a class="btn" href="/invoices/{{ invoice.id }}/view?print=1&amp;source=live" data-print="a5">4 Print</a>
    <button class="btn" type="button" data-modal-close>Close</button>
  </div>
</aa-modal>

{# ── State 999 finish: the payment dialog (reuses the payments form in a modal). ───────────────── #}
<aa-modal id="console-pay" title="Payment for #{{ invoice.invoiceNo }}">
  <p class="muted">Balance {{ invoice.balanceText }} · total {{ invoice.totalText }}</p>
  <aa-entity-form>
  <form method="post" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML" hx-push-url="/payments" action="/payments">
    <input type="hidden" name="invoice" value="{{ invoice.id }}">
    <label class="field"><span>Type</span>
      <select name="type">
        <option value="{{ 0 if type == 0 else 1 }}">{{ 'Sending' if type == 0 else 'Recieving' }}</option>
      </select>
    </label>
    <label class="field"><span>Amount</span><aa-money><input type="number" step="0.01" name="amount" value="{{ invoice.balanceText }}" data-console-pay-amount required></aa-money></label>
    <label class="field"><span>Date</span><input type="date" name="date" value="{{ today }}" required></label>
    <label class="field"><span>Party</span>
      <select name="party" data-searchable data-ref="parties">
        <option value="">No party</option>
        {% for p in parties %}<option value="{{ p.id }}"{% if invoice.party == p.id %} selected{% endif %}>{{ p.label }}</option>{% endfor %}
      </select>
    </label>
    <label class="field"><span>Description</span><input type="text" name="description" value="" autocomplete="off"></label>
    <div class="form-actions">
      <button class="btn primary" type="submit" data-console-pay-save>SAVE PAYMENT</button>
      <a class="btn" href="/invoices/{{ invoice.id }}/view?print=1&amp;source=live" target="_blank" rel="noopener" data-console-pay-print>Print preview</a>
      <button class="btn" type="button" data-modal-close>Close</button>
    </div>
  </form>
  </aa-entity-form>
</aa-modal>

{# ── the 000 advanced item search. Opened by `000` in the item field; filters items by company. ── #}
<aa-modal id="console-itemsearch" title="Advanced item search">
  <aa-item-search>
    <label class="field"><span>Company</span>
      <select data-is-company><option value="">All companies</option></select>
    </label>
    <label class="field"><span>Search</span><input type="text" data-is-query autocomplete="off" placeholder="Item name…"></label>
    <div class="tablewrap">
      <table class="data" data-mobile="cards">
        <thead><tr><th>Item</th><th class="right">Stock</th><th class="right">Sale</th><th></th></tr></thead>
        <tbody data-is-results></tbody>
      </table>
    </div>
  </aa-item-search>
</aa-modal>

{% if invoice.paidPayments|length %}
<section class="card">
  <h2>Payments ({{ invoice.paidPayments|length }})</h2>
  <div class="tablewrap">
  <table class="data" data-mobile="cards">
    <thead><tr><th>Date</th><th class="right">Amount</th><th>Description</th><th>Paid to</th></tr></thead>
    <tbody>
    {% for p in invoice.paidPayments %}
      <tr>
        <td data-label="Date" data-lead>{{ p.date }}</td>
        <td class="right" data-label="Amount">{{ p.amountText }}</td>
        <td data-label="Description">{{ p.description }}</td>
        <td data-label="Paid to">{{ p.paidTo }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}
{% endif %}
</aa-invoice-view>
{% endblock %}
