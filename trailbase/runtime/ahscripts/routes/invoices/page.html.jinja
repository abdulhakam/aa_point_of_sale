{% extends 'layout.html.jinja' %}
{% import 'partials/icons.html.jinja' as icons %}
{% block body %}
{# ⚠️ The legacy `/app/invoices` is a hub of FIVE tiles, not a list — Purchase, Sale, Print Invoices,
   Return, Difference — in that order and with those labels (measured off the live legacy hub). Each
   leads to an entry (or print) screen; the list lives at `/invoices/all` now. See
   [[ui-parity-discrepancies-2026-10-08]] §2. #}
<section class="card hub" hx-boost="true" hx-target="#app-main" hx-swap="innerHTML">
  <div class="hub-title upper">Invoices</div>
  <div class="tiles">
    <a class="tile" href="/invoices/new?type=0"><span class="c-pink-4">{{ icons.svg('file-invoice', 64) }}</span><span class="tile-label">Purchase</span></a>
    <a class="tile" href="/invoices/new?type=1"><span class="c-green">{{ icons.svg('clipboard-plus', 64) }}</span><span class="tile-label">Sale</span></a>
    <a class="tile" href="/print"><span class="c-green">{{ icons.svg('printer', 64) }}</span><span class="tile-label">Print Invoices</span></a>
    <a class="tile" href="/invoices/new?type=2"><span class="c-red">{{ icons.svg('arrow-back', 64) }}</span><span class="tile-label">Return</span></a>
    <a class="tile" href="/invoices/new?type=3"><span class="c-orange-4">{{ icons.svg('arrows-diff', 64) }}</span><span class="tile-label">Difference</span></a>
  </div>
</section>
<p class="crumbs"><a href="/invoices/all">All invoices →</a></p>
{% endblock %}
