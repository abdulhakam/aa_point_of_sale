{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "avatar": {"type": "string"},
          "email": {"type": "string", "format": "email"},
          "password_hash": {"type": "string"},
          "email_verified": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "password_hash"]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "name"]
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "section": {"type": "string"},
          "deleted": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "name"]
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "deleted": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "name"]
      }
    },
    "expenses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "amount": {"type": "number", "minimum": 0},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "name", "amount", "date"]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "category": {"type": "string"},
          "cost_price": {"type": "number", "minimum": 0},
          "sale_price": {"type": "number", "minimum": 0},
          "box_size_qty": {"type": "integer", "minimum": 0},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "name"]
      }
    },
    "invoices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["purchase","sale","return","difference"]},
          "invoiceNo": {"type": "number"},
          "booker": {"type": "string"},
          "party": {"type": "string"},
          "invoice_maker": {"type": "string"},
          "discount_1": {"type": "number", "minimum": 0},
          "discount_2": {"type": "number", "minimum": 0},
          "description": {"type": "string"},
          "duedate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "completed": {"type": "boolean"},
          "deleted": {"type": "boolean"},
          "dated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "discount_rs": {"type": "number", "minimum": 0},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "type"]
      }
    },
    "invoices_return_reference": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "original_invoices": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id"]
      }
    },
    "order_bookers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "phone": {"type": "string"},
          "company": {"type": "string"},
          "deleted": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "name"]
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["supplier","customer"]},
          "phone": {"type": "string"},
          "address": {"type": "string"},
          "area": {"type": "string"},
          "deleted": {"type": "boolean"},
          "company": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "name"]
      }
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "invoice": {"type": "string"},
          "type": {"type": "string", "enum": ["sending","recieving","return"]},
          "party": {"type": "string"},
          "amount": {"type": "number", "minimum": 0},
          "description": {"type": "string"},
          "paid": {"type": "boolean"},
          "payment_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "paid_to": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id"]
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "invoice": {"type": "string"},
          "item": {"type": "string"},
          "cost_price": {"type": "number", "minimum": 0},
          "price": {"type": "number", "minimum": 0},
          "qty": {"type": "integer", "minimum": 0},
          "scheme": {"type": "number"},
          "discount_1": {"type": "number", "minimum": 0},
          "discount_2": {"type": "number", "minimum": 0},
          "deleted": {"type": "boolean"},
          "discount_rs": {"type": "number", "minimum": 0},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["id", "invoice", "item"]
      }
    }
  },
  "additionalProperties": false
}