{
  "title": "Sales Report",
  "template": "page.html",
  "needs": { "views": ["paymentsView", "invoiceView", "refs"] },
  "compute": { "report": "salesreport" },
  "filters": [
    { "name": "from", "label": "Date From", "type": "date", "default": { "fn": "monthStart" } },
    { "name": "to", "label": "Date To", "type": "date", "default": { "fn": "today" } },
    { "name": "party", "label": "Party", "type": "select", "source": "parties" },
    { "name": "area", "label": "Area", "type": "select", "source": "areas" },
    { "name": "section", "label": "Section", "type": "select", "source": "sections" },
    { "name": "booker", "label": "Booker", "type": "select", "source": "order_bookers" },
    { "name": "invoice", "label": "Invoice #", "type": "text" }
  ],
  "columns": [
    { "key": "date", "label": "Date" },
    { "key": "type", "label": "Type" },
    { "key": "invoice", "label": "Inv #" },
    { "key": "area", "label": "Area" },
    { "key": "section", "label": "Section" },
    { "key": "party", "label": "Party" },
    { "key": "booker", "label": "Booker" },
    { "key": "amountText", "label": "Amount", "right": true }
  ],
  "totals": [
    { "label": "Sales Amount", "key": "recieving" },
    { "label": "Recieved Amount", "key": "recieved" },
    { "label": "Returns", "key": "recievingReturns" },
    { "label": "Recivable Amount", "key": "totalRecieving" }
  ]
}
