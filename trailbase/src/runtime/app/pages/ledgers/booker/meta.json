{
  "title": "Booker Sales Ledger",
  "template": "page.html",
  "needs": { "views": ["ledgerBooker", "invoiceView", "refs"] },
  "compute": { "report": "ledgers/booker" },
  "requires": ["booker"],
  "filters": [
    { "name": "from", "label": "Date From", "type": "date", "default": { "fn": "monthStart" } },
    { "name": "to", "label": "Date To", "type": "date", "default": { "fn": "today" } },
    { "name": "booker", "label": "Booker", "type": "select", "source": "order_bookers" }
  ],
  "columns": [
    { "key": "date", "label": "Date" },
    { "key": "invoice", "label": "Inv #" },
    { "key": "entry", "label": "Entry" },
    { "key": "creditText", "label": "Credit", "right": true },
    { "key": "debitText", "label": "Debit", "right": true }
  ],
  "totals": [
    { "label": "Total Credit", "key": "credit" },
    { "label": "Total Debit", "key": "debit" },
    { "label": "Final Balance", "key": "balance" }
  ]
}
