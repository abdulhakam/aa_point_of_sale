{
  "title": "General Ledger",
  "template": "page.html",
  "needs": { "views": ["ledgerJournal"] },
  "compute": { "report": "ledgers/general" },
  "filters": [
    { "name": "from", "label": "Date From", "type": "date", "default": { "fn": "monthStart" } },
    { "name": "to", "label": "Date To", "type": "date", "default": { "fn": "today" } },
    { "name": "openingRecievables", "label": "Opening Recievables", "type": "text", "default": "0" },
    { "name": "openingPayables", "label": "Opening Payables", "type": "text", "default": "0" },
    { "name": "openingCash", "label": "Opening Cash", "type": "text", "default": "0" }
  ],
  "columns": [
    { "key": "date", "label": "Date" },
    { "key": "invoiceNo", "label": "Inv #" },
    { "key": "description", "label": "Description" },
    { "key": "transactionType", "label": "Type" },
    { "key": "accountType", "label": "Account" },
    { "key": "recievableText", "label": "Recievables", "right": true },
    { "key": "payableText", "label": "Payables", "right": true },
    { "key": "cashText", "label": "Cash", "right": true }
  ],
  "totals": [
    { "label": "Recievables", "key": "recievable" },
    { "label": "Payables", "key": "payable" },
    { "label": "Cash", "key": "cash" }
  ]
}
