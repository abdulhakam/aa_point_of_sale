{
  "title": "Daily Sale Report",
  "template": "page.html",
  "needs": { "views": ["invoiceView", "refs"] },
  "compute": { "report": "dailysale" },
  "filters": [
    { "name": "from", "label": "Date From", "type": "date", "default": { "fn": "today" } },
    { "name": "to", "label": "Date To", "type": "date", "default": { "fn": "today" } },
    { "name": "booker", "label": "Booker", "type": "select", "source": "order_bookers" },
    { "name": "area", "label": "Area", "type": "select", "source": "areas" },
    { "name": "section", "label": "Section", "type": "select", "source": "sections" }
  ],
  "columns": [
    { "key": "invoiceNo", "label": "Invoice No" },
    { "key": "party", "label": "Customer Name" },
    { "key": "area", "label": "Area" },
    { "key": "booker", "label": "Booker" },
    { "key": "totalText", "label": "Total Amount", "right": true }
  ],
  "totals": [{ "label": "Total", "key": "total" }]
}
